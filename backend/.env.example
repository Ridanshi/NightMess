# MongoDB connection string
# Local: mongodb://localhost:27017/nightMess
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/nightMess
MONGODB_URI=mongodb://localhost:27017/nightMess

# Express session secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_secret

# Resend API key for transactional email notifications
# Get one at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Frontend origin for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:3000

# Server port (optional, defaults to 5000)
PORT=5000
